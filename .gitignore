# Package-specific ignores
# local.yml
# params/local.yaml
# Detector local runtime/data files. data/ holds the YOLO models and footage and
# is too large for git - see Octopus/detect-and-localize/README.md for its source.
Octopus/detect-and-localize/.venv/
Octopus/detect-and-localize/data/
Octopus/detect-and-localize/**/*.pyc
Octopus/detect-and-localize/**/__pycache__/

# Local PX4 ROS2 message dependency
Octopus/ros2_ws/src/px4_msgs/

# Local rosbridge dependency for the GripperX link. Third-party checkout with
# its own .git, so committing it would leave a submodule gitlink nobody can
# clone. Reproduce it with Octopus/scripts/build_rosbridge.sh, or install
# ros-humble-rosbridge-suite and delete the directory - the link is identical
# either way (see Octopus/docs/gripperx_rosbridge_link.md).
Octopus/ros2_ws_rosbridge/

# Python virtual environments (never commit these - they are multi-GB and
# contain absolute paths that break as soon as the repo is moved)
.venv/
venv/
env/

# pip bootstrap script
get-pip.py
