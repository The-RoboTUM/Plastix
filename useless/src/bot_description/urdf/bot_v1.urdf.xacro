<?xml version="1.0" encoding="utf-8"?>
<!-- Clean robot description only. Gazebo and ros2_control live in bot_v1.gazebo.xacro. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="bot_v1">
  <xacro:arg name="mesh_dir" default="package://bot_description/meshes" />
  <xacro:arg name="use_lidar" default="false" />
  <xacro:arg name="use_camera" default="false" />

  <xacro:include filename="bot_v1.core.xacro" />
  <xacro:include filename="bot_v1.lidar.xacro" />
  <xacro:include filename="bot_v1.camera.xacro" />
  <xacro:bot_robot mesh_dir="$(arg mesh_dir)" />

  <xacro:if value="$(arg use_lidar)">
    <xacro:bot_lidar add_gazebo="false" />
  </xacro:if>

  <xacro:if value="$(arg use_camera)">
    <xacro:bot_camera mesh_dir="$(arg mesh_dir)" add_gazebo="false" />
  </xacro:if>
</robot>
