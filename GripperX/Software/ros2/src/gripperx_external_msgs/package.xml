<?xml version="1.0"?>
<package format="3">
  <name>gripperx_external_msgs</name>
  <version>0.1.0</version>
  <description>Typed interfaces for the external-goal link (Octopus via rosbridge). Internal to GripperX: the wire format on the link itself is JSON.</description>
  <maintainer email="theo.blaesse@itq.de">Theo Blässe</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>rosidl_default_runtime</depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
