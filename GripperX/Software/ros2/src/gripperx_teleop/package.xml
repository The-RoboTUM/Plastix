<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gripperx_teleop</name>
  <version>0.1.0</version>
  <description>Teleop input multiplexer and keyboard teleop for GripperX.</description>
  <maintainer email="theo.blaesse@itq.de">Theo Blässe (ITQ GmbH)</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <!-- Second source for the measured steering angles when /hw/steer_states has
       no publisher (the twin). See web_teleop_node._measured_steer. -->
  <depend>sensor_msgs</depend>
  <!-- Crab/spin (FR-7): the keyboard teleop predicts the steering pose
       swerve_cmd_node will command, so its transition guard waits for exactly
       the angles the servos are being driven to. Reusing the kinematic model
       and the calibrated per-wheel windows instead of restating them here
       keeps one source of truth for a safety-relevant comparison. -->
  <depend>gripperx_control</depend>
  <!-- Arm/disarm keys call the external authority gate's SetArming service
       (gripperx_external/goal_gateway_node). -->
  <exec_depend>gripperx_external_msgs</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>gripperx_geometry</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
