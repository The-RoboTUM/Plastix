      ixx="0.000217447487430463"
      ixy="8.87032766970658E-07"
      ixz="3.29855165907127E-07"
      iyy="0.000126715873155165"
      iyz="-3.34669623327156E-05"
      izz="0.000169195628565899"
      mesh_file="back_left_steer.stl"
      rgba="${wheel_rgba}"
      collision_origin="0.000065 -0.005429 -0.075450"
      collision_size="0.043246 0.057000 0.150900"
      mesh_uri_root="${mesh_uri_root}" />

    <xacro:steer_joint
      name="b_leftsteer"
      xyz="${back_left_steer_xyz}"
      parent="chassis_link"
      child="back_left_steer"
      lower="${-steer_inward_limit}"
      upper="${steer_outward_limit}"
      effort="${joint_effort}"
      velocity="${joint_velocity}"
