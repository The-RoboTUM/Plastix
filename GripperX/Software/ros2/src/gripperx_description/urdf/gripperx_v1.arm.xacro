<?xml version="1.0" encoding="utf-8"?>
<!-- GripperX arm: LeRobot SO101, six Feetech STS3215 on one bus, IDs 1..6.

     SOURCE. Onshape assembly
       https://cad.onshape.com/documents/29f64c88cc8b05fe008f3ffb/w/07e6a2d6bfdcabed32906805/e/00267c0efb410c7fdc4fe747
     exported with onshape-to-robot 1.8.2 on 2026-10-07 and reduced to the arm by
     scripts/arm_from_cad_export.py (meshes in each link's own frame, then
     scripts/decimate_meshes.py, max bounding-box shift 0.66 mm). Joint origins
     below are the exporter's, with its rounded 1.5708 / 3.14159 written as exact
     pi fractions (difference 4e-6 rad, < 2 um at the arm's reach).

     q = 0 IS THE CAD ASSEMBLY POSE, which is the folded pose the former rigid
     arm_stowed.stl was baked from. Verified on export: the six limb meshes posed
     at q = 0 reproduce arm_stowed.stl to <= 0.23 mm in bounding box and
     <= 1.7 mm per vertex (the residual is that file's own decimation); the test
     gripperx_arm/test/test_kinematics.py re-checks this against the URDF.
     meshes/arm_stowed.stl is kept as that independent reference and is no
     longer rendered.

     NAMING. Joint <-> servo <-> arm_action_server name <-> CAD mate:
       arm_limb1_joint    ID 1  limb1    Arm_1  shoulder pan   (vertical axis)
       arm_limb2_joint    ID 2  limb2    Arm_2  shoulder lift
       arm_limb3_joint    ID 3  limb3    Arm_3  elbow
       arm_limb4_joint    ID 4  limb4    Arm_4  wrist flex
       arm_limb5_joint    ID 5  limb5    Arm_5  wrist roll
       arm_gripper_joint  ID 6  gripper  Arm_6  moving jaw
     The URDF names deliberately differ from the /arm/joint_states names: that
     topic carries RAW servo angles (ticks * 2 pi / 4096, no offset, no sign), not
     these joint angles. gripperx_arm's arm_joint_state_relay converts with
     gripperx_arm/config/arm_calibration.yaml. Order of IDs 1..5 along the chain
     follows the SO101 convention and GRIPPER_ID = 6 in arm_action_server;
     TO-VERIFY by the calibration procedure in arm_calibration.yaml.

     MOUNT AND LIMITS are declared in gripperx_geometry/config/geometry.yaml
     (arm_mount_xyz, arm_mount_rpy, arm_joint_lower, arm_joint_upper) and the
     properties below are checked consumers of it: edit there, then run the
     gripperx_geometry colcon tests. Onshape defines no mate limits (user,
     2026-08-18: limits are set on our side, not in CAD); the limits are derived
     from the follower's mechanical stops recorded 2026-10-08 and stay TO-VERIFY
     until the follower calibration is accepted (see geometry.yaml).
     effort / velocity 10 / 10 are the exporter's placeholders, not STS3215 data.

     MASS. TO-VERIFY. CAD masses are 1e-09 kg (unusable) and the arm has not been
     weighed; 0.001 kg per link is the same inert stand-in as before. Do not use
     this model for tipping, payload or traction statements.

     COLLISION. 1..4 boxes per link, GENERATED by scripts/arm_fit_collision.py
     from the meshes below (slabs along one link axis, triangles clipped at the
     slab planes, exact bounding box per slab + 2 mm per side). Their union
     encloses each mesh (tested) and, the 2 mm exceeding the 0.66 mm decimation
     shift, the CAD part. How loosely is recorded per link in
     gripperx_arm/config/arm_allowed_collisions.yaml (padding). Re-run the
     script after any mesh change and paste its output here.

     TCP. arm_tcp_link: on the wrist-roll axis at the fixed jaw's fingertip plane,
     z = approach direction (out of the jaws). Taken from the mesh: the jaws meet
     the plane 104.4 mm from the Arm_5 frame along the roll axis, centred on it to
     < 1 mm. The actual grasp depth behind the fingertips is a separate quantity
     and is not modelled here.

     ARTICULATED = false turns all six into fixed joints at q = 0 (the CAD pose).
     The Gazebo model uses that: Gazebo has no arm controller, and free revolute
     joints with 1 g links would flop. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="arm_mount_xyz" value="0.171223 -0.000151 0.115294" />
  <xacro:property name="arm_mount_rpy" value="3.141593 0.000000 1.570796" />
  <xacro:property name="arm_joint_lower" value="-1.884956 -3.342715 -0.012217 -3.229200 -2.705260 -0.325204" />
  <xacro:property name="arm_joint_upper" value="1.884956 0.159704 3.293627 0.112151 2.705260 1.825608" />

  <xacro:macro name="gripperx_arm_link" params="name mesh mesh_uri_root rgba **collisions">
    <link name="${name}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.001" />
        <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_uri_root}/${mesh}" />
        </geometry>
        <material name="">
          <color rgba="${rgba}" />
        </material>
      </visual>
      <xacro:insert_block name="collisions" />
    </link>
  </xacro:macro>

  <xacro:macro name="gripperx_arm_joint" params="name index parent child xyz rpy articulated">
    <xacro:if value="${articulated}">
      <joint name="${name}" type="revolute">
        <origin xyz="${xyz}" rpy="${rpy}" />
        <parent link="${parent}" />
        <child link="${child}" />
        <axis xyz="0 0 1" />
        <limit lower="${arm_joint_lower.split()[index]}" upper="${arm_joint_upper.split()[index]}"
          effort="10" velocity="10" />
      </joint>
    </xacro:if>
    <xacro:unless value="${articulated}">
      <joint name="${name}" type="fixed">
        <origin xyz="${xyz}" rpy="${rpy}" />
        <parent link="${parent}" />
        <child link="${child}" />
      </joint>
    </xacro:unless>
  </xacro:macro>

  <xacro:macro name="gripperx_arm" params="parent mesh_uri_root rgba articulated">
    <!-- Arm root = the Arm_1 axis, the frame the former rigid arm_stowed_link sat
         in (same origin, same rotation). The CAD arm frame is rolled 180 deg and
         yawed 90 deg against the chassis frame. Single declaration site of the arm
         mount pose is geometry.yaml (arm_mount_*); consumers read it from the URDF. -->
    <link name="arm_base_link" />
    <joint name="arm_mount_joint" type="fixed">
      <origin xyz="${arm_mount_xyz}" rpy="${arm_mount_rpy}" />
      <parent link="${parent}" />
      <child link="arm_base_link" />
    </joint>

    <xacro:gripperx_arm_link name="arm_limb1_link" mesh="arm_limb1.stl"
      mesh_uri_root="${mesh_uri_root}" rgba="${rgba}">
      <collisions>
        <collision>
          <origin xyz="0.0012 0.0201 -0.0369" rpy="0 0 0" />
          <geometry><box size="0.0592 0.0661 0.0595" /></geometry>
        </collision>
        <collision>
          <origin xyz="0.0000 0.0180 0.0186" rpy="0 0 0" />
          <geometry><box size="0.0440 0.0636 0.0595" /></geometry>
        </collision>
      </collisions>
    </xacro:gripperx_arm_link>
    <xacro:gripperx_arm_joint name="arm_limb1_joint" index="0" parent="arm_base_link"
      child="arm_limb1_link" xyz="0 0 0" rpy="0 0 0" articulated="${articulated}" />

    <xacro:gripperx_arm_link name="arm_limb2_link" mesh="arm_limb2.stl"
      mesh_uri_root="${mesh_uri_root}" rgba="${rgba}">
      <collisions>
        <collision>
          <origin xyz="-0.0247 -0.1127 0.0181" rpy="0 0 0" />
          <geometry><box size="0.0293 0.0290 0.0418" /></geometry>
        </collision>
        <collision>
          <origin xyz="0.0006 -0.0590 0.0163" rpy="0 0 0" />
          <geometry><box size="0.0293 0.1466 0.0714" /></geometry>
        </collision>
      </collisions>
    </xacro:gripperx_arm_link>
    <xacro:gripperx_arm_joint name="arm_limb2_joint" index="1" parent="arm_limb1_link"
      child="arm_limb2_link" xyz="0.0189 0.0306 -0.05415" rpy="0 ${-pi/2} 0"
      articulated="${articulated}" />

    <xacro:gripperx_arm_link name="arm_limb3_link" mesh="arm_limb3.stl"
      mesh_uri_root="${mesh_uri_root}" rgba="${rgba}">
      <collisions>
        <collision>
          <origin xyz="-0.0003 0.0271 0.0163" rpy="0 0 0" />
          <geometry><box size="0.0286 0.0828 0.0685" /></geometry>
        </collision>
        <collision>
          <origin xyz="-0.0043 0.1059 0.0164" rpy="0 0 0" />
          <geometry><box size="0.0412 0.0828 0.0604" /></geometry>
        </collision>
      </collisions>
    </xacro:gripperx_arm_link>
    <xacro:gripperx_arm_joint name="arm_limb3_joint" index="2" parent="arm_limb2_link"
      child="arm_limb3_link" xyz="-0.0269666 -0.11281 -0.0008" rpy="0 0 0"
      articulated="${articulated}" />

    <xacro:gripperx_arm_link name="arm_limb4_link" mesh="arm_limb4.stl"
      mesh_uri_root="${mesh_uri_root}" rgba="${rgba}">
      <collisions>
        <collision>
          <origin xyz="-0.0005 0.0268 -0.0067" rpy="0 0 0" />
          <geometry><box size="0.0346 0.0818 0.0248" /></geometry>
        </collision>
        <collision>
          <origin xyz="-0.0027 0.0435 0.0141" rpy="0 0 0" />
          <geometry><box size="0.0396 0.0484 0.0248" /></geometry>
        </collision>
        <collision>
          <origin xyz="-0.0027 0.0249 0.0349" rpy="0 0 0" />
          <geometry><box size="0.0395 0.0773 0.0248" /></geometry>
        </collision>
      </collisions>
    </xacro:gripperx_arm_link>
    <xacro:gripperx_arm_joint name="arm_limb4_joint" index="3" parent="arm_limb3_link"
      child="arm_limb4_link" xyz="-0.00637401 0.134799 -0.0008" rpy="0 0 ${pi/2}"
      articulated="${articulated}" />

    <!-- Roll 1.56211 is NOT a rounded pi/2: the CAD wrist mate is tilted
         0.00869 rad (0.5 deg) against limb4. Kept as exported. -->
    <xacro:gripperx_arm_link name="arm_limb5_link" mesh="arm_limb5.stl"
      mesh_uri_root="${mesh_uri_root}" rgba="${rgba}">
      <collisions>
        <collision>
          <origin xyz="-0.0003 0.0200 -0.0779" rpy="0 0 0" />
          <geometry><box size="0.0247 0.0282 0.0567" /></geometry>
        </collision>
        <collision>
          <origin xyz="-0.0022 0.0024 -0.0252" rpy="0 0 0" />
          <geometry><box size="0.0568 0.0695 0.0567" /></geometry>
        </collision>
      </collisions>
    </xacro:gripperx_arm_link>
    <xacro:gripperx_arm_joint name="arm_limb5_joint" index="4" parent="arm_limb4_link"
      child="arm_limb5_link" xyz="-0.00053434 0.0614977 0.0181" rpy="1.56211 ${pi/2} 0"
      articulated="${articulated}" />

    <xacro:gripperx_arm_link name="arm_gripper_link" mesh="arm_gripper.stl"
      mesh_uri_root="${mesh_uri_root}" rgba="${rgba}">
      <collisions>
        <collision>
          <origin xyz="-0.0588 0.0030 0.0189" rpy="0 0 0" />
          <geometry><box size="0.0503 0.0226 0.0223" /></geometry>
        </collision>
        <collision>
          <origin xyz="-0.0125 -0.0003 0.0187" rpy="0 0 0" />
          <geometry><box size="0.0503 0.0246 0.0523" /></geometry>
        </collision>
      </collisions>
    </xacro:gripperx_arm_link>
    <xacro:gripperx_arm_joint name="arm_gripper_joint" index="5" parent="arm_limb5_link"
      child="arm_gripper_link" xyz="0.0192 -0.0202 -0.0234" rpy="0 ${-pi/2} 0"
      articulated="${articulated}" />

    <link name="arm_tcp_link" />
    <joint name="arm_tcp_joint" type="fixed">
      <origin xyz="0 0 -0.1044" rpy="${pi} 0 0" />
      <parent link="arm_limb5_link" />
      <child link="arm_tcp_link" />
    </joint>
  </xacro:macro>
</robot>
