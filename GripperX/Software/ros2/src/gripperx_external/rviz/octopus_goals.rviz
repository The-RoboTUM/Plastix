Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Octopus preview1
      Splitter Ratio: 0.5
    Tree Height: 640
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        base_footprint:
          Value: true
        map:
          Value: true
        odom:
          Value: true
        octopus_line:
          Value: true
      Marker Scale: 0.6
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Tree:
        {}
      Update Interval: 0
      Value: true
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Update Topic:
        Value: /map_updates
      Use Timestamp: false
      Value: true
    - Alpha: 0.35
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Global costmap
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Use Timestamp: false
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Visual Enabled: true
      Value: true
    # The preview. ONE display for every marker namespace the gateway emits:
    #   octopus/objects     - the trash positions from /octopus/trash_gps
    #   octopus/labels      - id + the current validation verdict
    #   octopus/robot_goal  - the RESOLVED standing pose (blue arrow), present
    #                         only once grasp.offset_* stop being TO-VERIFY
    #   octopus/approach    - the approach arrow, standing pose -> object
    # The gateway sends DELETEALL before each set, so after a datum drag the
    # preview converges instead of leaving stale markers behind.
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Octopus preview
      Namespaces:
        {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /gripperx/external/preview_markers
      Value: true
    # The shared Octopus reference line (line_calibration_node): posts A/B, the
    # line, the octopus_line axis triad (x red, y green, z blue) at the midpoint
    # and "L = x.xxx m" - the number to enter on the drone side. Empty until
    # both posts are clicked with the Publish Point tool.
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Octopus line calibration
      Namespaces:
        {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /gripperx/external/line_calibration_markers
      Value: true
    # The clicks land on scan points, so the scan has to be visible.
    - Alpha: 1
      Class: rviz_default_plugins/LaserScan
      Color Transformer: FlatColor
      Color: 255; 255; 255
      Enabled: true
      Name: LaserScan
      Position Transformer: XYZ
      Size (m): 0.03
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Use Fixed Frame: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    # THE CALIBRATION TOOL. Click post A first, then post B, on their scan
    # clusters; each click goes to /clicked_point in the fixed frame (map).
    # Click ON each post's scan cluster, no offset towards the post centre
    # (user decision 2026-09-24, documentation/OCTOPUS_LINE_CALIBRATION.md 2).
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Value: /clicked_point
  # DELIBERATELY NO "2D Goal Pose" TOOL. It publishes /goal_pose, and the whole
  # point of FR-12 item 3 is that goals reach Nav2 through the action interface
  # only. (bt_navigator has no /goal_pose subscriber in this build anyway, so
  # the tool would be a silent no-op that looks like it worked.)
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 60
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1500
  X: 60
  Y: 60
