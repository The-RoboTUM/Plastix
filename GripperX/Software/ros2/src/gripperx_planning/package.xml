<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gripperx_planning</name>
  <version>0.0.0</version>
  <description>Motion planning and Nav2 navigation for the ITQ bot platform.</description>
  <maintainer email="kotteaditya919@gmail.com">aditya</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_dwb_controller</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <!-- Runtime: controller_server.FollowPath.plugin names
       nav2_rotation_shim_controller::RotationShimController (P2a, 2026-09-23)
       and pluginlib resolves it through the ament index. Without this package
       installed, controller_server fails to configure and the whole Nav2 stack
       never reaches active - the same failure mode gripperx_behaviors is
       listed against below. -->
  <exec_depend>nav2_rotation_shim_controller</exec_depend>
  <!-- Runtime: needs map + map→odom from gripperx_localization (AMCL or SLAM). -->
  <exec_depend>gripperx_localization</exec_depend>
  <!-- Runtime: config/nav2.yaml names gripperx_behaviors::CrabWalk in
       behavior_server.behavior_plugins, and pluginlib resolves that through the
       ament index. Without this package installed alongside, behavior_server
       fails to configure - the whole Nav2 stack then never reaches active. -->
  <exec_depend>gripperx_behaviors</exec_depend>

  <!-- The annulus-exclusion test drives the CONTROLLER'S OWN reachability
       logic (gripperx_control.steering_limits) against the active nav2.yaml,
       so the check cannot drift from the plant it is checking. -->
  <test_depend>gripperx_control</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
