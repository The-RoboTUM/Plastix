<?xml version="1.0" ?>
<sdf version="1.9">
  <!--
    testworld_v1 (DT-4 / M2): freely-designed Nav2 tuning world, replaces
    mapping_arena.world.sdf, which was dropped as inaccurate (see
    REQUIREMENTS.md DT-4/DT-9, docs/DIGITAL_TWIN_PLAN.md §3.2 item 5).
    mapping_arena.world.sdf remains untouched in the repo (possibly referenced
    by other milestones) but is no longer used for SLAM/Nav2 tuning.

    Layout (top view, x facing east, y facing north, origin at world center):
      12x12 m arena with closed outer walls.
      Central north-south corridor at x in [-0.9, 0.9], full length y -6..6,
      with a narrow section (chicane, ~0.9 m remaining width) at y in [2.9, 3.8].
      Four rooms left/right of the corridor (NW/SW/NE/SE), each connected to
      its neighboring room on the same side via a door opening (1.2 m) and
      connected to the central corridor via a door opening (1.4 m).
      Scattered obstacle pillars/crates/table in the rooms and the corridor.
  -->
  <world name="testworld_v1">
    <gravity>0 0 -9.81</gravity>
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics" />
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands" />
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster" />
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact" />
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu" />
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.78 0.78 0.78 1</ambient>
            <diffuse>0.78 0.78 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ Outer walls (closed, 12x12 m) ============ -->
    <model name="outer_wall_north">
      <static>true</static>
      <pose>0 6 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.2 0.2 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.2 0.2 2.0</size></box></geometry>
          <material><ambient>0.82 0.82 0.85 1</ambient><diffuse>0.82 0.82 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="outer_wall_south">
      <static>true</static>
      <pose>0 -6 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.2 0.2 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.2 0.2 2.0</size></box></geometry>
          <material><ambient>0.82 0.82 0.85 1</ambient><diffuse>0.82 0.82 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="outer_wall_east">
      <static>true</static>
      <pose>6 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 12.2 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 12.2 2.0</size></box></geometry>
          <material><ambient>0.82 0.82 0.85 1</ambient><diffuse>0.82 0.82 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="outer_wall_west">
      <static>true</static>
      <pose>-6 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 12.2 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 12.2 2.0</size></box></geometry>
          <material><ambient>0.82 0.82 0.85 1</ambient><diffuse>0.82 0.82 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============ Central north-south corridor: partition walls to the rooms ============ -->
    <!-- West wall of the corridor (x=-0.9), door opening 1.4 m at y in [-0.7, 0.7] -->
    <model name="corridor_wall_west_south">
      <static>true</static>
      <pose>-0.9 -3.35 1 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 5.3 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 5.3 2.0</size></box></geometry>
          <material><ambient>0.72 0.66 0.55 1</ambient><diffuse>0.72 0.66 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="corridor_wall_west_north">
      <static>true</static>
      <pose>-0.9 3.35 1 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 5.3 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 5.3 2.0</size></box></geometry>
          <material><ambient>0.72 0.66 0.55 1</ambient><diffuse>0.72 0.66 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East wall of the corridor (x=0.9), door opening 1.4 m at y in [-0.7, 0.7] -->
    <model name="corridor_wall_east_south">
      <static>true</static>
      <pose>0.9 -3.35 1 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 5.3 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 5.3 2.0</size></box></geometry>
          <material><ambient>0.72 0.66 0.55 1</ambient><diffuse>0.72 0.66 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="corridor_wall_east_north">
      <static>true</static>
      <pose>0.9 3.35 1 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 5.3 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 5.3 2.0</size></box></geometry>
          <material><ambient>0.72 0.66 0.55 1</ambient><diffuse>0.72 0.66 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Narrow section (chicane) in the corridor at y in [2.9, 3.8]: two offset
         stubs narrow the 1.8 m corridor width to ~0.9 m remaining width. -->
    <model name="chicane_stub_west">
      <static>true</static>
      <pose>-0.45 3.0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.9 0.2 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.9 0.2 2.0</size></box></geometry>
          <material><ambient>0.75 0.35 0.3 1</ambient><diffuse>0.75 0.35 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="chicane_stub_east">
      <static>true</static>
      <pose>0.45 3.7 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.9 0.2 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.9 0.2 2.0</size></box></geometry>
          <material><ambient>0.75 0.35 0.3 1</ambient><diffuse>0.75 0.35 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============ Room dividers left (NW/SW) and right (NE/SE), each at y=0,
         door opening 1.2 m ============ -->
    <model name="left_divider_outer">
      <static>true</static>
      <pose>-5.025 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.95 0.2 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.95 0.2 2.0</size></box></geometry>
          <material><ambient>0.58 0.72 0.63 1</ambient><diffuse>0.58 0.72 0.63 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="left_divider_inner">
      <static>true</static>
      <pose>-1.875 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.95 0.2 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.95 0.2 2.0</size></box></geometry>
          <material><ambient>0.58 0.72 0.63 1</ambient><diffuse>0.58 0.72 0.63 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="right_divider_inner">
      <static>true</static>
      <pose>1.875 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.95 0.2 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.95 0.2 2.0</size></box></geometry>
          <material><ambient>0.58 0.72 0.63 1</ambient><diffuse>0.58 0.72 0.63 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="right_divider_outer">
      <static>true</static>
      <pose>5.025 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.95 0.2 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.95 0.2 2.0</size></box></geometry>
          <material><ambient>0.58 0.72 0.63 1</ambient><diffuse>0.58 0.72 0.63 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============ Scattered obstacles ============ -->
    <model name="pillar_nw">
      <static>true</static>
      <pose>-3.4 4.3 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.22</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.82 0.63 0.28 1</ambient><diffuse>0.82 0.63 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_se">
      <static>true</static>
      <pose>3.6 -4.4 0.55 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.20</radius><length>1.1</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.20</radius><length>1.1</length></cylinder></geometry>
          <material><ambient>0.82 0.63 0.28 1</ambient><diffuse>0.82 0.63 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="crate_sw">
      <static>true</static>
      <pose>-3.7 -4.5 0.4 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.9 0.7 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.9 0.7 0.8</size></box></geometry>
          <material><ambient>0.7 0.52 0.34 1</ambient><diffuse>0.7 0.52 0.34 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="crate_ne_a">
      <static>true</static>
      <pose>3.3 4.6 0.35 0 0 -0.25</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.7 0.7 0.7</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.7 0.7 0.7</size></box></geometry>
          <material><ambient>0.7 0.52 0.34 1</ambient><diffuse>0.7 0.52 0.34 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="crate_ne_b">
      <static>true</static>
      <pose>4.6 3.9 0.35 0 0 0.5</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 0.7</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.7</size></box></geometry>
          <material><ambient>0.7 0.52 0.34 1</ambient><diffuse>0.7 0.52 0.34 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="loading_table_se">
      <static>true</static>
      <pose>2.7 -4.7 0.4 0 0 -0.4</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.4 0.8 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.4 0.8 0.8</size></box></geometry>
          <material><ambient>0.46 0.46 0.52 1</ambient><diffuse>0.46 0.46 0.52 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="corridor_barrel">
      <static>true</static>
      <pose>0 -3.4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.55 0.3 0.25 1</ambient><diffuse>0.55 0.3 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_sw_corridor">
      <static>true</static>
      <!-- DT-4 fix: originally placed at y=-5.0 directly in the spawn
           footprint (spawn_x/y=0/-5.0) -> collision when spawning the
           robot. Moved to y=-1.3 (still in the southern part of the
           corridor, before the chicane at y~3.3, but outside the spawn area). -->
      <pose>-0.35 -1.3 0.55 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.18</radius><length>1.1</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>1.1</length></cylinder></geometry>
          <material><ambient>0.82 0.63 0.28 1</ambient><diffuse>0.82 0.63 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
