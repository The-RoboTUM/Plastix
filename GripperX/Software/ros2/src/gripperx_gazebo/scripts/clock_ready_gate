#!/usr/bin/env python3
"""Block until /clock is ADVANCING, then exit 0. Sim-only ordering gate.

§3.1.7 "Clock-source hazard", decision of 2026-08-19 part (a) — D17.

WHY THIS EXISTS. Every freshness test in the motion command chain computes an
age as `now() - stamp` and compares it against a timeout. With
`use_sim_time:=true` and nothing publishing `/clock`, every ROS clock in the
process stays at 0, so every such age is 0 and every freshness test degrades to
"always fresh": the A2 `/teleop/direct_steer` override never expires,
swerve_controller's `cmd_vel_timeout_sec` never fires, and the GripperXInterface
watchdog's `command_timeout_sec` would not either. It fails toward "keep
commanding", and it does so silently — nothing logs and the chain looks healthy.

A controller that activates against a clock at zero has already lost its
timeouts before its first cycle. The sim bringup therefore chains the controller
spawners behind this process: it exits 0 only once `/clock` has been seen to
ADVANCE, so no controller can be spawned — let alone activated — before that.

WHY "ADVANCING" AND NOT "PRESENT". A single `/clock` message proves a publisher
exists; it does not prove time moves. A paused or stalled Gazebo publishes a
constant clock, and that is failure mode (ii) of §3.1.7 — the timeouts freeze
exactly as if the clock were at zero. Two strictly increasing samples is the
cheapest evidence that distinguishes the two.

WHY THE TIMEOUT EXITS NON-ZERO. On expiry this process fails, the OnProcessExit
handler it gates still fires with a non-zero return code, and the launch system
reports it. The deliberate direction is: no clock, no controllers. A bringup that
came up without a clock source is a bringup whose timeouts do not work, and it
must be visibly broken rather than quietly unsafe.

THE DEADLINE IS `time.monotonic()`, never a ROS clock. Measuring the wait for the
clock against the clock being waited for is the bug this file exists to prevent.
"""

import argparse
import sys
import time

import rclpy
from rclpy.node import Node
from rclpy.qos import QoSDurabilityPolicy, QoSHistoryPolicy, QoSProfile, QoSReliabilityPolicy
from rosgraph_msgs.msg import Clock


class ClockReadyGate(Node):
    def __init__(self, topic: str, advances_required: int) -> None:
        super().__init__("clock_ready_gate")
        self._advances_required = advances_required
        self._advances_seen = 0
        self._first_stamp_ns = None
        self._last_stamp_ns = None
        self.ready = False

        # BEST_EFFORT + VOLATILE on the SUBSCRIBER side on purpose: it is
        # compatible with a RELIABLE publisher as well, so this gate cannot fail
        # for a QoS reason against whichever /clock source is in front of it
        # (ros_gz_bridge today). A gate that reports "no clock" because of a QoS
        # mismatch would block a healthy bringup.
        qos = QoSProfile(
            history=QoSHistoryPolicy.KEEP_LAST,
            depth=10,
            reliability=QoSReliabilityPolicy.BEST_EFFORT,
            durability=QoSDurabilityPolicy.VOLATILE,
        )
        self.create_subscription(Clock, topic, self._on_clock, qos)
        self.get_logger().info(
            f"waiting for {topic} to ADVANCE "
            f"({advances_required} strictly increasing samples required)"
        )

    def _on_clock(self, msg: Clock) -> None:
        stamp_ns = msg.clock.sec * 1_000_000_000 + msg.clock.nanosec
        if self._first_stamp_ns is None:
            self._first_stamp_ns = stamp_ns
            self._last_stamp_ns = stamp_ns
            self.get_logger().info(f"first /clock sample: {stamp_ns / 1e9:.6f} s (not yet proof)")
            return
        if stamp_ns > self._last_stamp_ns:
            self._advances_seen += 1
            self.get_logger().info(
                f"/clock advanced {self._last_stamp_ns / 1e9:.6f} -> {stamp_ns / 1e9:.6f} s "
                f"({self._advances_seen}/{self._advances_required})"
            )
        self._last_stamp_ns = stamp_ns
        if self._advances_seen >= self._advances_required:
            self.ready = True


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--topic", default="/clock")
    parser.add_argument("--advances", type=int, default=2)
    parser.add_argument(
        "--timeout",
        type=float,
        default=60.0,
        help="Wall-clock seconds before giving up. Measured with time.monotonic().",
    )
    args, _ = parser.parse_known_args()

    rclpy.init()
    node = ClockReadyGate(args.topic, args.advances)
    deadline = time.monotonic() + args.timeout
    try:
        while rclpy.ok() and not node.ready and time.monotonic() < deadline:
            rclpy.spin_once(node, timeout_sec=0.1)

        if node.ready:
            node.get_logger().info(
                f"CLOCK READY after {args.timeout - (deadline - time.monotonic()):.2f}s wall — "
                "releasing the controller spawners"
            )
            return 0

        node.get_logger().error(
            f"CLOCK NOT READY: {args.topic} did not advance within {args.timeout:.1f}s wall. "
            "NO CONTROLLER IS SPAWNED. Every freshness test in the command chain would have run "
            "against a clock at zero and read 'always fresh' (internal REQUIREMENTS §3.1.7 / D17)."
        )
        return 1
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    sys.exit(main())
